  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Estas atrapado en el laboratorio abandonado de la universidad. Recupera
    las credenciales de acceso, descifra los codigos de seguridad y abre las puertas
    que comunican la recepcion, el laboratorio y la sala de control.

    Cada zona
    esconde objetos y pistas: explora con calma, guarda lo que encuentres y conserva
    la integridad.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
